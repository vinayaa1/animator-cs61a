{"data":{"assignment":{"id":"61a-fa26-animator","semester":"fa26"},"file_scope":{"complete":false,"watched":["index.html","animator.css","extension.txt","gleam.toml","manifest.toml"]},"format_version":"1.0","git_capture":"available","host":{"editor":"vscode","editor_build":"","editor_version":"1.146.0","platform":"win32-x64"},"machine_id":"7429bde5da3d78e0286e46b27158d8dc14855f409da2074e2845819f2b94d7f4","manifest":{"assignment_id":"61a-fa26-animator","attachments":[".server_logs/"],"collaboration":"solo","course_cert":{"course_id":"berkeley-cs61a","course_pubkey":"3c07361fc4dd70eedbfc0fe6cf90a1f9a5438ee70248938c16683d269bbf6192","root_sig":"3847ccb2c7ab3145776ac9e62d61bd954f71e163e14a3016045ae00db50c3170c77f17242af09904fd0f40a7c60e0a3ca730ae11519b9d18fe5bd4f9bcb2b201","valid_from":"2026-08-20","valid_until":"2027-01-15"},"course_id":"berkeley-cs61a","files_under_review":["src/","index.html","animator.css","extension.txt","gleam.toml","manifest.toml"],"format_version":"2.0","ignore":[],"issued_at":"2026-11-07T07:59:00Z","policy":{"capture":{"focus_change":true,"heartbeat_interval_ms":30000,"selection_change":true,"terminal":true},"enrollment":{"required":false}},"scope":"directory","semester":"fa26","sig":"98c8c97fdaf491fbfb7a795ad25e1949b0037d1e01a719d6ba7c781db8f203d3c5dbf3a36bb43990f4a71b32a7ab51f12fb0cd5770f5f92eac3e8ca825efb30c","submission":"bundle"},"manifest_sig":"98c8c97fdaf491fbfb7a795ad25e1949b0037d1e01a719d6ba7c781db8f203d3c5dbf3a36bb43990f4a71b32a7ab51f12fb0cd5770f5f92eac3e8ca825efb30c","prev_session_id":null,"recorder":{"extension_id":"itsgeagle.provenance-recorder","version":"2.0.2"},"session_id":"0388d42d-a42d-4234-9b5c-aad9e3092e1e","session_pubkey":"1adaa98e935fe8bd5a34c35c260f57e629c0ff3c412ed6a67632925b4a9f2433","vscode":{"commit":"","platform":"win32-x64","version":"1.146.0"},"witness_capture":"available"},"hash":"b26675d70765262b342c356fe683275e15bbb86347c670a9b2ba29d78bd12831","kind":"session.start","prev_hash":"0000000000000000000000000000000