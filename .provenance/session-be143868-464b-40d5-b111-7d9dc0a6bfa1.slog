{"data":{"extensions":[{"enabled":true,"id":"TypeScriptTeam.jsts-chat-features","version":"0.0.7"},{"enabled":false,"id":"vscode.bat","version":"10.0.0"},{"enabled":false,"id":"vscode.clojure","version":"10.0.0"},{"enabled":false,"id":"vscode.coffeescript","version":"10.0.0"},{"enabled":true,"id":"vscode.configuration-editing","version":"10.0.0"},{"enabled":false,"id":"vscode.cpp","version":"10.0.0"},{"enabled":false,"id":"vscode.csharp","version":"10.0.0"},{"enabled":false,"id":"vscode.css","version":"10.0.0"},{"enabled":false,"id":"vscode.css-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.dart","version":"10.0.0"},{"enabled":true,"id":"vscode.debug-auto-launch","version":"10.0.0"},{"enabled":false,"id":"vscode.debug-server-ready","version":"10.0.0"},{"enabled":false,"id":"vscode.diff","version":"10.0.0"},{"enabled":false,"id":"vscode.docker","version":"10.0.0"},{"enabled":false,"id":"vscode.dotenv","version":"10.0.0"},{"enabled":true,"id":"vscode.emmet","version":"10.0.0"},{"enabled":false,"id":"vscode.extension-editing","version":"10.0.0"},{"enabled":false,"id":"vscode.fsharp","version":"10.0.0"},{"enabled":true,"id":"vscode.git","version":"10.0.0"},{"enabled":true,"id":"vscode.git-base","version":"10.0.0"},{"enabled":true,"id":"vscode.github","version":"0.0.1"},{"enabled":true,"id":"vscode.github-authentication","version":"0.0.2"},{"enabled":false,"id":"vscode.go","version":"10.0.0"},{"enabled":false,"id":"vscode.groovy","version":"10.0.0"},{"enabled":false,"id":"vscode.grunt","version":"10.0.0"},{"enabled":false,"id":"vscode.gulp","version":"10.0.0"},{"enabled":false,"id":"vscode.handlebars","version":"10.0.0"},{"enabled":false,"id":"vscode.hlsl","version":"10.0.0"},{"enabled":false,"id":"vscode.html","version":"10.0.0"},{"enabled":false,"id":"vscode.html-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.ini","version":"10.0.0"},{"enabled":false,"id":"vscode.ipynb","version":"10.0.0"},{"enabled":false,"id":"vscode.jake","version":"10.0.0"},{"enabled":false,"id":"vscode.java","version":"10.0.0"},{"enabled":false,"id":"vscode.javascript","version":"10.0.0"},{"enabled":false,"id":"vscode.json","version":"10.0.0"},{"enabled":true,"id":"vscode.json-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.julia","version":"10.0.0"},{"enabled":false,"id":"vscode.latex","version":"10.0.0"},{"enabled":false,"id":"vscode.less","version":"10.0.0"},{"enabled":false,"id":"vscode.log","version":"10.0.0"},{"enabled":false,"id":"vscode.lua","version":"10.0.0"},{"enabled":false,"id":"vscode.make","version":"10.0.0"},{"enabled":false,"id":"vscode.markdown","version":"30.0.0"},{"enabled":false,"id":"vscode.markdown-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.markdown-math","version":"10.0.0"},{"enabled":true,"id":"vscode.merge-conflict","version":"10.0.0"},{"enabled":false,"id":"vscode.mermaid-markdown-features","version":"10.0.0"},{"enabled":false,"id":"vscode.microsoft-authentication","version":"0.0.1"},{"enabled":false,"id":"ms-vscode.js-debug","version":"1.140.1"},{"enabled":false,"id":"ms-vscode.js-debug-companion","version":"1.1.3"},{"enabled":false,"id":"ms-vscode.vscode-js-profile-table","version":"1.0.11"},{"enabled":false,"id":"vscode.builtin-notebook-renderers","version":"10.0.0"},{"enabled":true,"id":"vscode.npm","version":"10.0.0"},{"enabled":false,"id":"vscode.objective-c","version":"10.0.0"},{"enabled":false,"id":"vscode.perl","version":"10.0.0"},{"enabled":false,"id":"vscode.php","version":"10.0.0"},{"enabled":false,"id":"vscode.php-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.powershell","version":"10.0.0"},{"enabled":false,"id":"vscode.prompt","version":"10.0.0"},{"enabled":false,"id":"vscode.pug","version":"10.0.0"},{"enabled":false,"id":"vscode.python","version":"10.0.0"},{"enabled":false,"id":"vscode.r","version":"10.0.0"},{"enabled":false,"id":"vscode.razor","version":"10.0.0"},{"enabled":false,"id":"vscode.references-view","version":"10.0.0"},{"enabled":false,"id":"vscode.restructuredtext","version":"10.0.0"},{"enabled":false,"id":"vscode.ruby","version":"10.0.0"},{"enabled":false,"id":"vscode.rust","version":"10.0.0"},{"enabled":false,"id":"vscode.scss","version":"10.0.0"},{"enabled":false,"id":"vscode.search-result","version":"10.0.0"},{"enabled":false,"id":"vscode.shaderlab","version":"10.0.0"},{"enabled":false,"id":"vscode.shellscript","version":"10.0.0"},{"enabled":false,"id":"vscode.simple-browser","version":"10.0.0"},{"enabled":false,"id":"vscode.sql","version":"10.0.0"},{"enabled":false,"id":"vscode.swift","version":"10.0.0"},{"enabled":true,"id":"vscode.terminal-suggest","version":"1.0.1"},{"enabled":false,"id":"vscode.theme-abyss","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-defaults","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-kimbie-dark","version":"10.0.0"},{"enabled":false,"id":"vscode.vscode-modern-icons","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-monokai","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-monokai-dimmed","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-quietlight","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-red","version":"10.0.0"},{"enabled":false,"id":"vscode.vscode-theme-seti","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-solarized-dark","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-solarized-light","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-tomorrow-night-blue","version":"10.0.0"},{"enabled":false,"id":"vscode.tunnel-forwarding","version":"10.0.0"},{"enabled":false,"id":"vscode.typescript","version":"10.0.0"},{"enabled":true,"id":"vscode.typescript-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.vb","version":"10.0.0"},{"enabled":false,"id":"vscode.xml","version":"10.0.0"},{"enabled":false,"id":"vscode.yaml","version":"10.0.0"},{"enabled":true,"id":"berkeley-ai4ed.preceptor","version":"0.1.6"},{"enabled":false,"id":"GitHub.codespaces","version":"1.18.17"},{"enabled":false,"id":"GitHub.remotehub","version":"0.66.0"},{"enabled":false,"id":"github.vscode-github-actions","version":"0.32.3"},{"enabled":true,"id":"GitHub.vscode-pull-request-github","version":"0.180.0"},{"enabled":true,"id":"gleam.gleam","version":"2.13.1"},{"enabled":true,"id":"itsgeagle.provenance-recorder","version":"2.0.2"},{"enabled":false,"id":"ms-python.debugpy","version":"2026.6.0"},{"enabled":false,"id":"ms-python.python","version":"2026.10.0"},{"enabled":false,"id":"ms-python.vscode-pylance","version":"2026.4.1"},{"enabled":false,"id":"ms-python.vscode-python-envs","version":"1.44.0"},{"enabled":false,"id":"ms-toolsai.jupyter","version":"2025.9.1"},{"enabled":false,"id":"ms-toolsai.jupyter-keymap","version":"1.1.2"},{"enabled":false,"id":"ms-toolsai.jupyter-renderers","version":"1.3.0"},{"enabled":false,"id":"ms-toolsai.vscode-jupyter-cell-tags","version":"0.1.9"},{"enabled":false,"id":"ms-toolsai.vscode-jupyter-slideshow","version":"0.1.6"},{"enabled":false,"id":"ms-vscode.cmake-tools","version":"1.25.10"},{"enabled":false,"id":"ms-vscode.cpp-devtools","version":"0.7.2"},{"enabled":false,"id":"ms-vscode.cpptools","version":"1.35.6"},{"enabled":false,"id":"ms-vscode.cpptools-extension-pack","version":"1.5.1"},{"enabled":false,"id":"ms-vscode.cpptools-themes","version":"2.0.0"},{"enabled":false,"id":"ms-vscode.remote-repositories","version":"0.44.0"},{"enabled":true,"id":"PawelHuryn.grok-vscode-phuryn","version":"4.17.9"},{"enabled":true,"id":"ritwickdey.LiveServer","version":"5.7.10"},{"enabled":false,"id":"SamRC.night-pink","version":"0.5.0"},{"enabled":true,"id":"WakaTime.vscode-wakatime","version":"30.2.1"}]},"hash":"64407b40864437aa5963e5f77123a9514709a2db68661104efa714125a5f5fdf","kind":"ext.snapshot","prev_hash":"4e013d829cd4589876111d4b412e890d8c7994396bc4cd066773b762c7211542","seq":254,"t":2700089,"wall":"2026-11-23T21:20:53.909Z"}
