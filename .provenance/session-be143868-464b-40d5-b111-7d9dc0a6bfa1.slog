{"data":{"deltas":[{"range":{"end":{"character":0,"line":363},"start":{"character":0,"line":0}},"text":"\n//// Animator -- an application for program-generated drawings.\n\nimport builtins\nimport data\nimport drawing\nimport editor\nimport errors\nimport examples\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/result\nimport lustre\nimport lustre/attribute as attr\nimport lustre/effect.{type Effect}\nimport lustre/element.{type Element, none}\nimport lustre/element/html\nimport lustre/event\nimport parser\nimport render\nimport shape.{type Path}\n\n/// Your app's public address, once deployed.\npub const public_url = \"\"\n\n/// Set to True to include your app in the gallery.\npub const include_app_in_gallery = False\n\n/// Link to your video.\npub const video_url = \"\"\n\n/// Set to True to include your video in the gallery.\npub const include_video_in_gallery = False\n\nconst default_code = \"fn draw(shape_slider: Int) -> List(Path) {\\n  [Path(Line(Point(0, 0), Point(100, 100)), 0, 10, 2)]\\n}\\n\"\n\n// ── Model ──────────────────────────────────────────────\n\npub type Model {\n  Model(\n    source: String,\n    code_open: Bool,\n    output: String,\n    shape_slider: Int,\n    speed: Float,\n    drawings: List(#(String, String)),\n    current: String,\n  )\n}\n\npub type Msg {\n  SetCode(String)\n  ToggleCode\n  SetShapeSlider(String)\n  SetSpeed(String)\n  SelectDrawing(String)\n  NewDrawing\n  ResetAnimation\n}\n\n// ── Init ───────────────────────────────────────────────\n\npub fn init(_flags: Nil) -> #(Model, Effect(Msg)) {\n  let drawings = data.load_drawings(examples.all)\n\n  let current = case data.load_current() {\n    \"\" -> first_name(drawings)\n    saved ->\n      case find_source(drawings, saved) {\n        Ok(_) -> saved\n        Error(_) -> first_name(drawings)\n      }\n  }\n\n  let source = case find_source(drawings, current) {\n    Ok(code) -> code\n    Error(_) -> default_code\n  }\n\n  #(\n    Model(\n      source: source,\n      code_open: True,\n      output: \"\",\n      shape_slider: 10,\n      speed: 1.0,\n      drawings: drawings,\n      current: current,\n    ),\n    effect.batch([\n      editor.mount(source, SetCode),\n      effect.from(fn(dispatch) {\n        render.set_speed(1.0)\n        dispatch(SetCode(source))\n      }),\n    ]),\n  )\n}\n\n// ── Drawing Helpers ────────────────────────────────────\n\nfn first_name(drawings: List(#(String, String))) -> String {\n  case drawings {\n    [#(name, _), ..] -> name\n    [] -> \"\"\n  }\n}\n\nfn find_source(\n  drawings: List(#(String, String)),\n  name: String,\n) -> Result(String, Nil) {\n  case drawings {\n    [] -> Error(Nil)\n    [#(key, source), ..rest] ->\n      case key == name {\n        True -> Ok(source)\n        False -> find_source(rest, name)\n      }\n  }\n}\n\nfn replace_source(\n  drawings: List(#(String, String)),\n  name: String,\n  source: String,\n) -> List(#(String, String)) {\n  list.map(drawings, fn(entry) {\n    let #(key, old_source) = entry\n\n    case key == name {\n      True -> #(key, source)\n      False -> #(key, old_source)\n    }\n  })\n}\n\n// ── Parsing and Evaluation ─────────────────────────────\n\nfn run_source(\n  shape_slider: Int,\n  source: String,\n) -> Result(List(Path), String) {\n  case parser.parse_program(source, builtins.global_frame()) {\n    Error(msg) -> Error(msg)\n    Ok(program) ->\n      drawing.try_draw(shape_slider, program)\n      |> result.map_error(errors.error_message)\n  }\n}\n\nfn evaluate(source: String, slider: Int) -> String {\n  case run_source(slider, source) {\n    Ok(paths) -> {\n      let rendered = list.map(paths, fn(path) {\n        render.render_path(path, \"#2563eb\")\n      })\n\n      render.set_drawing(rendered)\n      \"\"\n    }\n\n    Error(message) -> {\n      render.set_drawing([])\n      message\n    }\n  }\n}\n\n// ── Update ─────────────────────────────────────────────\n\npub fn update(model: Model, msg: Msg) -> #(Model, Effect(Msg)) {\n  case msg {\n    ToggleCode ->\n      #(\n        Model(..model, code_open: !model.code_open),\n        effect.none(),\n      )\n\n    SetCode(text) -> {\n      let drawings = replace_source(\n        model.drawings,\n        model.current,\n        text,\n      )\n\n      data.save_drawings(drawings)\n      data.save_current(model.current)\n\n      let output = evaluate(text, model.shape_slider)\n\n      #(\n        Model(\n          ..model,\n          source: text,\n          drawings: drawings,\n          output: output,\n        ),\n        effect.none(),\n      )\n    }\n\n    SetShapeSlider(value) -> {\n      let slider = case int.parse(value) {\n        Ok(n) -> n\n        Error(_) -> model.shape_slider\n      }\n\n      let output = evaluate(model.source, slider)\n\n      #(\n        Model(\n          ..model,\n          shape_slider: slider,\n          output: output,\n        ),\n        effect.none(),\n      )\n    }\n\n    SetSpeed(value) -> {\n      let speed = case float.parse(value) {\n        Ok(n) -> n\n        Error(_) -> model.speed\n      }\n\n      render.set_speed(speed)\n\n      #(\n        Model(..model, speed: speed),\n        effect.none(),\n      )\n    }\n\n    SelectDrawing(name) -> {\n      case name {\n        \"\" -> update(model, NewDrawing)\n\n        _ ->\n          case find_source(model.drawings, name) {\n            Error(_) ->\n              #(model, effect.none())\n\n            Ok(source) -> {\n              data.save_current(name)\n\n              #(\n                Model(..model, current: name),\n                editor.mount(source, SetCode),\n              )\n            }\n          }\n      }\n    }\n\n    NewDrawing -> {\n      let name = data.prompt_drawing_name()\n\n      case name {\n        \"\" ->\n          #(model, effect.none())\n\n        _ -> {\n          let drawings = case find_source(model.drawings, name) {\n            Ok(_) -> model.drawings\n            Error(_) ->\n              list.append(\n                model.drawings,\n                [#(name, default_code)],\n              )\n          }\n\n          let source = case find_source(drawings, name) {\n            Ok(code) -> code\n            Error(_) -> default_code\n          }\n\n          data.save_drawings(drawings)\n          data.save_current(name)\n\n          #(\n            Model(\n              ..model,\n              current: name,\n              drawings: drawings,\n            ),\n            editor.mount(source, SetCode),\n          )\n        }\n      }\n    }\n\n    ResetAnimation -> {\n      render.reset_clock()\n\n      let output = evaluate(\n        model.source,\n        model.shape_slider,\n      )\n\n      #(\n        Model(..model, output: output),\n        effect.none(),\n      )\n    }\n  }\n}\n\n// ── View ───────────────────────────────────────────────\n\npub fn view(model: Model) -> Element(Msg) {\n  let app_class = case model.code_open {\n    True -> \"app\"\n    False -> \"app code-hidden\"\n  }\n\n  html.div([attr.class(app_class)], [\n    html.div([attr.class(\"code-col\")], [\n      editor.view_panel(ToggleCode),\n    ]),\n    view_anim(model),\n  ])\n}\n\nfn view_anim(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"canvas-area\")], [\n    view_reveal_code(model),\n\n    html.div([attr.class(\"controls\")], [\n      view_drawing_select(model),\n\n      html.div([attr.class(\"slider-control\")], [\n        html.label([], [\n          html.text(\n            \"Shape: \" <> int.to_string(model.shape_slider),\n          ),\n        ]),\n        html.input([\n          attr.type_(\"range\"),\n          attr.attribute(\"data-test-id\", \"shape-slider\"),\n          attr.min(\"0\"),\n          attr.max(\"100\"),\n          attr.step(\"1\"),\n          attr.value(int.to_string(model.shape_slider)),\n          event.on_input(SetShapeSlider),\n        ]),\n      ]),\n\n      html.div([attr.class(\"slider-control\")], [\n        html.label([], [\n          html.text(\n            \"Speed: \" <> float.to_string(model.speed),\n          ),\n        ]),\n        html.input([\n          attr.type_(\"range\"),\n          attr.attribute(\"data-test-id\", \"speed-slider\"),\n          attr.min(\"-3\"),\n          attr.max(\"3\"),\n          attr.step(\"0.1\"),\n          attr.value(float.to_string(model.speed)),\n          event.on_input(SetSpeed),\n        ]),\n      ]),\n\n      html.button(\n        [event.on_click(ResetAnimation)],\n        [html.text(\"Reset\")],\n      ),\n    ]),\n\n    html.canvas([\n      attr.id(\"animation-canvas\"),\n      attr.class(\"canvas\"),\n    ]),\n\n    case model.output {\n      \"\" -> none()\n      message ->\n        html.pre(\n          [attr.class(\"output\")],\n          [html.text(message)],\n        )\n    },\n  ])\n}\n\n// ── Drawing Selection ──────────────────────────────────\n\nfn view_drawing_select(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"drawing-picker\")], [\n    html.label([], [\n      html.text(\"Drawing: \"),\n    ]),\n\n    html.select(\n      [\n        attr.attribute(\"data-test-id\", \"drawing-select\"),\n        attr.value(model.current),\n        event.on_change(SelectDrawing),\n      ],\n      list.map(model.drawings, fn(entry) {\n        let #(name, _) = entry\n\n        html.option(\n          [attr.value(name)],\n          name,\n        )\n      })\n      |> list.append([\n        html.option(\n          [attr.value(\"\")],\n          \"+ New drawing\",\n        ),\n      ]),\n    ),\n  ])\n}\n\n// ── Show/Hide Code ─────────────────────────────────────\n\nfn view_reveal_code(model: Model) -> Element(Msg) {\n  case model.code_open {\n    True -> none()\n\n    False ->\n      html.button(\n        [\n          attr.class(\"icon-btn reveal-code\"),\n          attr.attribute(\"title\", \"Show code\"),\n          event.on_click(ToggleCode),\n        ],\n        [html.text(\"⟩\")],\n      )\n  }\n}\n\n// ── Main ───────────────────────────────────────────────\n\npub fn main() -> Nil {\n  let app = lustre.application(init, update, view)\n  let assert Ok(_) = lustre.start(app, \"#app\", Nil)\n  Nil\n}\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"14088e2ddcec349d915d3f80dd0824bcce315d1e432e7bba65edafe47fb16916","kind":"doc.change","prev_hash":"38b810179fee900b5e33d0750f3b6d9c4c5f8f914e0cd823417c226b12a92df5","seq":264,"t":2777530,"wall":"2026-11-23T21:22:11.351Z"}
